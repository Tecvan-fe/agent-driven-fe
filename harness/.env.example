# harness 配置示例 —— 提交进仓库,只列名不列值。
# 真正的 .env 被 .gitignore 忽略,严禁把真值写进这里(本仓库是 public)。
# 复制为 .env 后填入真实值:cp .env.example .env

# 目标仓库(owner/name 分开填)
HARNESS_REPO_OWNER=
HARNESS_REPO_NAME=

# daemon 监听端口(隧道把公网流量转发到 localhost:此端口)
HARNESS_PORT=8787

# GitHub webhook 密钥。注册 webhook 时填的 secret 必须与此一致。
# 生成:openssl rand -hex 20
HARNESS_WEBHOOK_SECRET=

# 触发词:PR 评论正文包含它才受理(默认 @claude)
HARNESS_TRIGGER_WORD=@claude

# 被驱动的 lab 仓库绝对路径(agent 在此 cwd 下改代码)
HARNESS_LAB_DIR=

# 传给 claude -p 的模型(opus / sonnet / haiku / fable 或完整模型名)
HARNESS_MODEL=sonnet

# 状态与日志目录(相对 harness/ 或绝对路径),默认 ./state 与 ./logs
HARNESS_STATE_DIR=./state
HARNESS_LOG_DIR=./logs

# dry-run:置 1 时跳过真跑 claude 与 push,只走编排(本地 curl 联调用)
HARNESS_DRY_RUN=0
